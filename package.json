{
  "name": "knegarloggen-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:knegarloggen": "pnpm --filter knegarloggen run dev",
    "dev:giggerloggen": "pnpm --filter giggerloggen run dev",
    "dev:hemfixloggen": "pnpm --filter hemfixloggen run dev",
    "build": "pnpm -r run build",
    "build:knegarloggen": "pnpm --filter knegarloggen run build",
    "build:giggerloggen": "pnpm --filter giggerloggen run build",
    "build:hemfixloggen": "pnpm --filter hemfixloggen run build",
    "lint": "pnpm -r --if-present run lint",
    "type-check": "pnpm -r --if-present run type-check"
  }
}
